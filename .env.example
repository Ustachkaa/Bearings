# ── Bearings server ─────────────────────────────────────────────────────────
PORT=7300

# Where the SQLite database lives (created automatically)
DATA_DIR=./server/data

# ── Email alerts (Gmail) ────────────────────────────────────────────────────
# 1. Turn on 2-Step Verification for your Google account.
# 2. Visit https://myaccount.google.com/apppasswords and create an App Password
#    (name it "Bearings"). Google shows a 16-character code — paste it below.
# 3. Alerts will be sent FROM this Gmail TO the address in ALERT_TO.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_FROM="Bearings <your.address@gmail.com>"
ALERT_TO=your.address@gmail.com

# How often the alert engine checks prices (cron syntax). Default: every 30 minutes.
CHECK_CRON=*/30 * * * *

# Timezone used for reminders and digests
TZ=Asia/Tbilisi
